{
  "name": "traceable-reference-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Reference app for the traceable-backend skill: manifests, drift detection, per-role grants, audit trail, node/gate runs and a DevOps UI.",
  "license": "Apache-2.0",
  "scripts": {
    "setup": "bash scripts/setup-db.sh",
    "manifests:validate": "node --env-file-if-exists=.env ../../scripts/validate-manifests.mjs",
    "grants:generate": "node --env-file-if-exists=.env ../../scripts/generate-grants.mjs",
    "drift": "node --env-file-if-exists=.env ../../scripts/check-drift.mjs",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "demo": "tsx --env-file-if-exists=.env scripts/demo.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "hono": "^4.6.14",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "prisma": "7.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "yaml": "^2.6.1"
  }
}
