# Owner role: migrations and the drift checker's catalog queries ONLY.
# Needs CREATEDB (Prisma's shadow database) and CREATEROLE (generated grants).
DATABASE_URL=postgresql://app_owner:demo_owner_pw@127.0.0.1:5432/traceable_demo

# One connection string per actor. Role names are derived from the manifests:
# a service called tenant-admin gets svc_tenant_admin; a job called
# tenant-status-review gets job_tenant_status_review.
DATABASE_URL_SVC_HEALTH=postgresql://svc_health:demo_pw@127.0.0.1:5432/traceable_demo
DATABASE_URL_SVC_TENANT_ADMIN=postgresql://svc_tenant_admin:demo_pw@127.0.0.1:5432/traceable_demo
DATABASE_URL_SVC_DEVOPS=postgresql://svc_devops:demo_pw@127.0.0.1:5432/traceable_demo
DATABASE_URL_JOB_TENANT_STATUS_REVIEW=postgresql://job_tenant_status_review:demo_pw@127.0.0.1:5432/traceable_demo

PORT=3000

# Optional. Without it, the LLM node uses a deterministic offline stub that
# reports token counts and a generation id prefixed "stub-".
# OPENROUTER_API_KEY=
